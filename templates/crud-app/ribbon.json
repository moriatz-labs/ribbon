{
  "$schema": "./schemas/ribbon.schema.json",
  "manifestVersion": 2,
  "name": "__APP_TITLE__",
  "slug": "__APP_SLUG__",
  "description": "",
  "framework": "vite-react",
  "projectType": "application",
  "providers": {
    "deployment": {
      "provider": "vercel",
      "projectName": "__APP_SLUG__",
      "cnameTarget": "cname.vercel-dns.com"
    },
    "backend": {
      "provider": "supabase"
    },
    "dns": {
      "provider": "hostinger",
      "domain": "__BASE_DOMAIN__",
      "hostname": "__APP_DOMAIN__",
      "ttl": 300
    },
    "mail": {
      "provider": "hostinger-mail",
      "apiTokenEnv": "HOSTINGER_MAIL_API_TOKEN",
      "mailboxIdEnv": "HOSTINGER_MAILBOX_ID",
      "fromEnv": "HOSTINGER_MAIL_FROM"
    },
    "designSystem": {
      "provider": "strawn",
      "source": "npm",
      "version": "0.1.0",
      "packages": ["strawn", "strawn-icons"],
      "requiredComponents": ["ThemeProvider", "TooltipProvider"]
    }
  },
  "urls": {
    "local": "http://localhost:5173"
  },
  "status": "local",
  "createdAt": "__CREATED_AT__"
}
