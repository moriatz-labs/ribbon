{
  "name": "@vscd/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck && vite build",
    "dev": "vite",
    "lint": "pnpm typecheck",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@vscd/core": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "strawn": "0.1.0",
    "strawn-icons": "0.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vercel/node": "^5.5.3",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.12"
  }
}
