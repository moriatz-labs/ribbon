CREATE CONSTRAINT user_id IF NOT EXISTS FOR (n:User) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT repository_id IF NOT EXISTS FOR (n:Repository) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT oauth_state IF NOT EXISTS FOR (n:OAuthPendingState) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT browser_session IF NOT EXISTS FOR (n:BrowserSession) REQUIRE n.id IS UNIQUE;
