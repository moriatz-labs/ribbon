{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "api": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "rewrites": [
    { "source": "/auth/(.*)", "destination": { "service": "api" } },
    { "source": "/graphql", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/sync/(.*)", "destination": { "service": "api" } },
    { "source": "/bookmarks", "destination": { "service": "api" } },
    { "source": "/categories", "destination": { "service": "api" } },
    { "source": "/explore/snapshots", "destination": { "service": "api" } },
    { "source": "/explore", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
